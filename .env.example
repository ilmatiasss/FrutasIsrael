# Copia este archivo como .env.local (en tu PC) o pon estas variables en Vercel.

# Connection string de Neon (Dashboard → Connect → "Pooled connection").
# Si no está, la app funciona en "modo prueba" (datos solo en el navegador).
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Clave de INSTALACIÓN (un solo uso): se pide en /instalar para que nadie más
# pueda instalar antes que ustedes. Después de instalar no da acceso a nada:
# la clave del portal y las cuentas de administrador viven cifradas en la base.
CLAVE_ACCESO=cambia-esta-clave
